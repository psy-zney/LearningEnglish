# Local-first SQLite database. Do not point this at the backup file.
DATABASE_URL="file:dev.db"

# Required only on the Windows host. Omit on Vercel; every non-backend value disables /api.
APP_DEPLOYMENT_MODE="backend"

# Public HTTP API used by both Server and Client Components. No trailing slash.
NEXT_PUBLIC_API_URL="http://127.0.0.1:1002"

# Optional when using a remote libSQL database.
DATABASE_AUTH_TOKEN=""

# Required on the public Windows backend for every state-changing API.
# Login issues a seven-day HttpOnly signed cookie; never commit real values.
ADMIN_PASSWORD_HASH="replace-with-a-sha256-hash"
TOKEN_SALT="replace-with-a-long-random-value"

# Exact comma-separated cross-origin clients. Credentialed CORS never uses a wildcard.
ALLOWED_ORIGINS="https://study.zney295.id.vn,http://localhost:1002,http://localhost:3000"

# Optional local AI enrichment.
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"

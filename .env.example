# Local-first SQLite database. Do not point this at the backup file.
DATABASE_URL="file:dev.db"

# Optional when using a remote libSQL database.
DATABASE_AUTH_TOKEN=""

# Legacy vocabulary administration only. Generate a SHA-256 hash; never commit a real value.
ADMIN_PASSWORD_HASH="replace-with-a-sha256-hash"
TOKEN_SALT="replace-with-a-long-random-value"

# Comma-separated cross-origin clients. Same-origin requests are allowed automatically.
ALLOWED_ORIGINS="http://localhost:3000"

# Optional local AI enrichment.
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
